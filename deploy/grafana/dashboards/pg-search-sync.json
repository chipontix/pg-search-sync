{
 "uid": "pg-search-sync",
 "title": "pg-search-sync",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Rows captured from WAL /s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(go_pq_cdc_insert_total[1m]))",
     "legendFormat": "insert"
    },
    {
     "refId": "B",
     "expr": "sum(rate(go_pq_cdc_update_total[1m]))",
     "legendFormat": "update"
    },
    {
     "refId": "C",
     "expr": "sum(rate(go_pq_cdc_delete_total[1m]))",
     "legendFormat": "delete"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Indexer bulk items /s by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(indexer_items_total[1m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "WAL message \u2192 bulk acknowledged (excludes ES refresh)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(indexer_source_lag_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(indexer_source_lag_seconds_bucket[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Elasticsearch bulk duration",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(indexer_bulk_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(indexer_bulk_seconds_bucket[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Replication slot lag / retained WAL",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "go_pq_cdc_replication_slot_slot_lag",
     "legendFormat": "lag"
    },
    {
     "refId": "B",
     "expr": "go_pq_cdc_replication_slot_slot_retained_wal_size",
     "legendFormat": "retained WAL"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Retry and dead letter",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kafka_cronsumer_retried_messages_total_current",
     "legendFormat": "cronsumer retried"
    },
    {
     "refId": "B",
     "expr": "kafka_cronsumer_discarded_messages_total_current",
     "legendFormat": "cronsumer discarded"
    },
    {
     "refId": "C",
     "expr": "kafka_konsumer_unprocessed_messages_total_current",
     "legendFormat": "konsumer unprocessed"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Resident memory",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "process_resident_memory_bytes",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(process_cpu_seconds_total[1m])",
     "legendFormat": "{{job}}"
    }
   ]
  }
 ]
}
